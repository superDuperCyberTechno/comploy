#change to the directory of this file so all commands work as expected, making this file callable from wherever
SCRIPT_PATH=$(dirname $(realpath "$0"))
cd "$SCRIPT_PATH"

# Update comploy itself from its repository, keeping this file's user config.
# The config variable assignments (hosts, ignored_files, key, use_git,
# use_composer, post_deployment_commands) are copied onto the newest version
# before this file is replaced. The previous version is kept as a comploy.bak
# next to this file. The download source can be overridden with the
# COMPLOY_UPDATE_URL environment variable (for mirrors or local testing).
# Versions are compared as semantic versions (MAJOR.MINOR.PATCH); the old
# two-number format (e.g. 2.8) is treated as MAJOR.MINOR.0.

# exit 0 if $1 > $2, where both are versions of the form N, N.N or N.N.N
semver_gt() {
    local -a ver_a ver_b
    local i
    IFS='.' read -ra ver_a <<< "${1}"
    IFS='.' read -ra ver_b <<< "${2}"
    for i in 0 1 2; do
        if (( ${ver_a[i]:-0} > ${ver_b[i]:-0} )); then
            return 0
        fi
        if (( ${ver_a[i]:-0} < ${ver_b[i]:-0} )); then
            return 1
        fi
    done
    return 1
}

update_comploy() {
    url="${COMPLOY_UPDATE_URL:-https://raw.githubusercontent.com/superDuperCyberTechno/comploy/master/comploy}"
    me="$(realpath "$0")"
    tmp="$(mktemp -d)"
    trap 'rm -rf "${tmp}"' EXIT
    new_file="${tmp}/comploy.new"
    cfg_file="${tmp}/comploy.cfg"

    echo "Downloading latest comploy from ${url}..."
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "${url}" -o "${new_file}"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "${url}" -O "${new_file}"
    else
        echo "ERROR: update needs curl or wget to download" >&2
        return 1
    fi

    # the download has to look like comploy and parse cleanly
    if ! bash -n "${new_file}" 2>/dev/null || ! grep -q '^declare -A hosts' "${new_file}"; then
        echo "ERROR: downloaded file is not a valid comploy script; nothing changed" >&2
        return 1
    fi

    old_ver="$(sed -n '/^# comploy /{s/^# comploy //p;q;}' "${me}")"
    new_ver="$(sed -n '/^# comploy /{s/^# comploy //p;q;}' "${new_file}")"
    if [[ -z "${new_ver}" ]] || ! [[ "${new_ver}" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]]; then
        echo "ERROR: downloaded file has an unparseable version '${new_ver}'; nothing changed" >&2
        return 1
    fi
    if ! [[ "${old_ver}" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]]; then
        echo "ERROR: this file has an unparseable version '${old_ver}'; refusing to update" >&2
        return 1
    fi
    if semver_gt "${new_ver}" "${old_ver}"; then
        echo "New version available: comploy ${old_ver} -> ${new_ver}"
    elif semver_gt "${old_ver}" "${new_ver}"; then
        echo "Installed comploy ${old_ver} is newer than ${new_ver}; not downgrading"
        return 0
    else
        echo "Already up to date (comploy ${new_ver})"
        return 0
    fi

    # extract the active (non-comment) config assignments from the current file
    awk '/^#customize by editing vars below$/{in_cfg=1; next}
         /^#here be dragons, steel thyself$/{in_cfg=0}
         in_cfg && $0 !~ /^[[:space:]]*#/ && NF {print}' "${me}" > "${cfg_file}"

    # in the download, replace the ported config assignments in place: the
    # user's scalar values overwrite the download's own assignments wherever
    # they appear (keeping the surrounding comments), and the user's hosts
    # entries are dropped in at the hosts spot; comments and examples of the
    # new version stay untouched
    awk -v cfg="${cfg_file}" '
        BEGIN {
            # load the user config, grouped by variable name
            while ((getline line < cfg) > 0) {
                if (line ~ /^hosts\[/) {
                    user_hosts[nh++] = line
                } else {
                    name = line
                    sub(/=.*/, "", name)
                    sub(/\+$/, "", name)
                    user_lines[name] = user_lines[name] (user_lines[name] ? "\n" : "") line
                }
            }
            close(cfg)
            in_cfg = 0
            hosts_done = 0
        }
        /^#customize by editing vars below$/{in_cfg = 1}
        /^#here be dragons, steel thyself$/{in_cfg = 0; if (!hosts_done) { for (i = 0; i < nh; i++) print user_hosts[i]; hosts_done = 1 } }
        in_cfg && $0 ~ /^key=/ && !hosts_done { for (i = 0; i < nh; i++) print user_hosts[i]; hosts_done = 1 }
        in_cfg && $0 ~ /^(ignored_files|key|use_git|use_composer|post_deployment_commands)(\+?)=/ {
            name = $0
            sub(/=.*/, "", name)
            sub(/\+$/, "", name)
            if (user_lines[name] != "" && !emitted[name]) {
                print user_lines[name]
                emitted[name] = 1
            } else if (!emitted[name]) {
                print
            }
            next
        }
        in_cfg && $0 ~ /^hosts\[/ { next }
        { print }
    ' "${new_file}" > "${tmp}/comploy.final"

    # everything ported must survive the merge, and the result must parse
    for v in ignored_files key use_git use_composer post_deployment_commands; do
        if ! grep -q "^${v}=" "${tmp}/comploy.final"; then
            echo "ERROR: '${v}' missing after merge; download may be incompatible, keeping the current version" >&2
            return 1
        fi
    done
    if ! bash -n "${tmp}/comploy.final" 2>/dev/null; then
        echo "ERROR: merged comploy failed syntax check; keeping the current version" >&2
        return 1
    fi

    cp -p "${me}" "${me}.bak"
    mv "${tmp}/comploy.final" "${me}"
    chmod --reference "${me}.bak" "${me}" 2>/dev/null || chmod +x "${me}"
    echo "Updated comploy from ${old_ver} to ${new_ver}. Previous version kept as ${me}.bak"
    echo "Run comploy again (without --update) to deploy."
}

# ./comploy --update (or -u) updates comploy itself, then exits
case "${1:-}" in
    --update|-u)
        update_comploy
        exit 0
        ;;
esac

# Validate the host config before anything destructive happens. An empty or
# relative server_dir would make `rsync --delete` target the wrong place - in
# the worst case the server's home directory or filesystem root - so refuse to
# run with missing or invalid entries.
valid_hosts=0
for host in "${!hosts[@]}"; do
    server_dir="${hosts[$host]}"
    if [[ -z "${host}" ]] || [[ -z "${server_dir}" ]]; then
        echo "WARNING: skipping invalid host entry ('${host}' -> '${server_dir}'); remove it or fill in both host and server_dir" >&2
        unset "hosts[$host]"
        continue
    fi
    if [[ "${server_dir}" != /* ]]; then
        echo "ERROR: server_dir '${server_dir}' for host '${host}' must be an absolute path starting with '/' (e.g. /var/www/example/html)" >&2
        exit 1
    fi
    if [[ "${server_dir}" == "/" ]]; then
        echo "ERROR: server_dir for host '${host}' must not be the filesystem root '/'">&2
        exit 1
    fi
    valid_hosts=$((valid_hosts + 1))
done
if [[ "${valid_hosts}" -eq 0 ]]; then
    echo "ERROR: no valid hosts configured. Add at least one host/server_dir pair to the hosts array before running comploy." >&2
    exit 1
fi

#if we use git, we want to also ignore the git folder
if $use_git; then
    ignored_files+=' /.git'
fi

#if we haven't set the key, then simply use the local id_rsa
if [[ -z "${key}" ]]; then
    key="${HOME}/.ssh/id_rsa"
fi

#this block is only for initial commits, to make sure we deploy a complete codebase on first deployment
#(runs before composer swaps the local packages to production, so an abort leaves the dev environment intact)
if $use_git; then
    for host in "${!hosts[@]}"; do
        server_dir="${hosts[$host]}"
        #detect if we already have deployed by checking if the folder's empty
        is_first_run=$(ssh -i "${key}" "root@${host}" 'if [ -z "$(ls -A '${server_dir}')" ];then echo 1;fi;')

        #if there are uncommitted shit on first run
        if [[ $is_first_run ]] && { [[ $(git ls-files -m) ]] || [[ $(git ls-files . --exclude-standard --others) ]]; }; then
            echo "ABORTING: Make sure that your first deploy is from a fresh repository with NO modified - OR untracked files."
            exit 1
        fi
    done
fi

#if we use composer, deploy production packages and autoloader
if $use_composer; then
    echo "Installing production environment"
    composer install --quiet --no-dev --optimize-autoloader
fi

#if you provide comploy with an argument (string), use it as commit message if there's staged files. otherwise, simply deploy all unchanged files (since last commit)
if $use_git; then
    #if we're really lazy, omit the quotation marks for our commit message and just let this snippet squash it all together
    commit_msg="$*"

    if [[ $(git diff --cached --exit-code) ]] && [[ "${commit_msg}" ]] && [[ "${commit_msg}" != " " ]];then
        git commit -m "${commit_msg}"
    fi
fi

#add the ignore files from the config header var (replace space with newline)
echo "${ignored_files}" | tr ' ' '\n' > /tmp/comploy_ignore;

if $use_git; then
    #add all modified files to ignore list
    git ls-files -m >> /tmp/comploy_ignore
    #add the untracked files to the deploy ignore list
    git ls-files . --exclude-standard --others >> /tmp/comploy_ignore
fi

#sync the files
for host in "${!hosts[@]}"; do
    server_dir="${hosts[$host]}"
    echo "Syncing with ${host}..."
    # server_dir is validated above to be a non-empty absolute path, never the
    # home directory or filesystem root, so --delete can only touch the target
    rsync -e "ssh -i ${key}" -a --delete --delay-updates --exclude-from "/tmp/comploy_ignore" ./ "root@${host}:${server_dir}"

    #set the correct permissions
    ssh -i "${key}" "root@${host}" "chown -R www-data:www-data ${server_dir};find ${server_dir} -type f ! -perm 644 -exec chmod 644 {} \;;find ${server_dir} -type d ! -perm 755 -exec chmod 755 {} \;;"

    if [[ "${post_deployment_commands}" ]];then
        echo "Executing post deployment commands"
        ssh -i "${key}" "root@${host}" "${post_deployment_commands}"
    fi
done

#re-install the dev-environment
if $use_composer; then
    echo "Installing development environment..."
    composer install --quiet
fi

#push to external repository
if $use_git; then
    echo "Pushing to Git repo"
    git push --quiet
fi

#all is well
echo "Project synced and ready to go!"
